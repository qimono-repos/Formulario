<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Formulario.MainPage">

        <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Image 
                Source="face1.png"
                HeightRequest="150" 
                WidthRequest="150" 
                HorizontalOptions="Center"
                VerticalOptions="Center"
            >
            </Image>
            <Frame 
                Grid.Row="0" 
                Grid.Column="1" 
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BorderColor="DarkGray"
                Margin="5"
                Padding="4"
                HasShadow="False"
                IsVisible="{Binding UpdateFace1}"
                >
                <!-- <StackLayout Padding="0" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" BackgroundColor="Black"  > -->
                    <Image 
                        BackgroundColor="Transparent"
                        VerticalOptions="Fill"
                        Aspect="AspectFit"
                        Source="{Binding PhotoPath}" 
                        HeightRequest="200" />
                <!-- </StackLayout> -->
            </Frame>
            <Label Text="{Binding PhotoPath}" TextColor="Black" IsVisible="False" />
            <Grid Grid.Row="2" HorizontalOptions="Fill" Padding="20,10,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="CounterBtn" Grid.Column="0" Text="Cámara" Style="{StaticResource buttonNav}" Margin="0,0,12,0" Clicked="OpenAddPhoto_Clicked"/>
                <Button x:Name="GalleryBtn" Grid.Column="1" Text="Galería" Style="{StaticResource buttonNav}" Margin="12,0,0,0" Clicked="OpenAddGallery_Clicked"/>
            </Grid>

            <!--<Button
                x:Name="CounterBtn"
                Text="Abrir la cámara" 
                SemanticProperties.Hint="Importar fotos desde galeria"
                ClassId="1" 
                Clicked="OpenAddPhoto_Clicked"
                HorizontalOptions="Fill" />-->
        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
