<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Formulario.MainPage">

        <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Image 
                Source="face1.png"
                HeightRequest="150" 
                WidthRequest="150" 
                HorizontalOptions="Center"
                VerticalOptions="Center"
            >
            </Image>

            <Button
                x:Name="CounterBtn"
                Text="Abrir la cámara" 
                SemanticProperties.Hint="Importar fotos desde galeria"
                ClassId="1" 
                Clicked="OpenAddPhoto_Clicked"
                HorizontalOptions="Fill" />
        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
